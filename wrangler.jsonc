{
  "name": "anyhenge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Let the Worker rewrite OpenGraph tags on the index page
    "run_worker_first": ["/"]
  },
  // Browser Run, used to screenshot views for /og.jpg.
  // quickAction() isn't supported locally, so dev uses the remote binding.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "routes": [
    {
      "pattern": "anyhenge.ziki.boo/*",
      "zone_name": "ziki.boo"
    }
  ]
}
